# See https://www.dartlang.org/guides/libraries/private-files

# Files and directories created by pub
.dart_tool/
.packages
build/
# Workspace projects manage dependencies at the root level
pubspec.lock

# Directory created by dartdoc
# If you don't generate documentation locally you can remove this line.
doc/api/

# Test coverage
coverage/

# dotenv environment variables file
.env*

# Avoid committing generated Javascript files:
*.dart.js
# Produced by the --dump-info flag.
*.info.json
# When generated by dart2js. Don't specify *.js if your
# project includes source files written in JavaScript.
*.js
*.js_
*.js.deps
*.js.map

.flutter-plugins
.flutter-plugins-dependencies

# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# macOS
.DS_Store

# Windows
Thumbs.db

/refs/
CLAUDE.local.md
.claude/

/scripts/
.mcp.json
specs/

# dart compile wasm output and wrangler state (examples/edge-sample)
.out/
.wrangler/
.vercel/

# local dependency overrides (e.g. a sibling checkout of a dependency)
pubspec_overrides.yaml

# The benchmark apps pin the versions they were measured against.
!/bench/apps/*/pubspec.lock
!/bench/runner/pubspec.lock
!/bench/runner/test/fixtures/pubspec.lock

# Cloud benchmark: real project ids and refs live only in the local config.
/bench/cloud/config.yaml
/bench/cloud/**/build/
/bench/cloud/supabase/supabase/functions/*/main.wasm
/bench/cloud/supabase/supabase/functions/*/main.mjs
/bench/cloud/supabase/supabase/functions/*/main.support.js
/bench/cloud/supabase/supabase/functions/*/main.wasm.map
/bench/cloud/supabase/supabase/.temp/
/bench/cloud/supabase/.temp/
/bench/cloud/functions/.firebaserc
/bench/cloud/functions/.firebase/
/bench/cloud/functions/native/node_modules/
# Generated by package:firebase_functions (build_runner) at build/deploy time.
/bench/cloud/functions/aim/functions.yaml
/bench/cloud/**/.wrangler/
!/bench/cloud/workers/aim/pubspec.lock
!/bench/cloud/supabase/aim_app/pubspec.lock
!/bench/cloud/functions/aim/pubspec.lock

# The repo-wide `*.js` rule above (meant for dart2js output) would otherwise
# swallow this handler's source.
!/bench/cloud/functions/native/index.js
